{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-idea-factory-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "ideas-api.utkualbayrak.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "WEB_ORIGIN": "https://ideas.utkualbayrak.dev,https://app-idea-factory.utkualbayrakrak.workers.dev",
    // "En son kim güncelledi" için Access JWT doğrulaması (src/identity.ts).
    // AUD'lar: web uygulaması (/api proxy'si) ve API uygulaması (doğrudan) —
    // Zero Trust > Access > Applications > uygulama > Overview > "Application Audience (AUD) Tag".
    "ACCESS_TEAM_DOMAIN": "utkualbayrakrak.cloudflareaccess.com",
    "ACCESS_AUDS": "d9c389f7905dc7c1b773161375b94fd3b9baa0cf381ab40783d67b3de613816d,b56c603b20019a8a7324aa15bb909cc2d46c55e0f8e2129e40d0eaf51c9cfa7f"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-idea-factory-db",
      "database_id": "05ca3282-5e95-4718-b02c-3e75a21a9f5e"
    }
  ]
}
