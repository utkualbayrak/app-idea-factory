{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-idea-factory-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WEB_ORIGIN": "https://app-idea-factory.utkualbayrakrak.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-idea-factory-db",
      "database_id": "05ca3282-5e95-4718-b02c-3e75a21a9f5e"
    }
  ]
}
