{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-idea-factory",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "services": [
    {
      "binding": "API",
      "service": "app-idea-factory-api"
    }
  ]
}
